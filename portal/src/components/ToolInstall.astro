---
/** Download buttons, numbered install steps and guide links for a standalone tool. */
import Cmd from './Cmd.astro';
import { TOOLS, UI } from '../lib/site.mjs';

interface Props { lang: 'es' | 'en'; slug: string; compact?: boolean }
const { lang, slug, compact = false } = Astro.props;
const t = UI[lang];
const tool = TOOLS[slug];
const steps = compact ? tool.steps.slice(0, 1) : tool.steps;
---
<div class="ti">
  {tool.downloads.length > 0 && (
    <div class="ti__downloads">
      {tool.downloads.map((d: any) => (
        <a class="ti__dl" href={d.href} rel="noopener">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M2.5 13.5h11"/></svg>
          <span><strong>{d.label[lang]}</strong><small>{d.detail[lang]}</small></span>
        </a>
      ))}
    </div>
  )}
  {tool.unsigned && !compact && <p class="ti__note">{tool.unsigned[lang]}</p>}
  <ol class="ti__steps" class:list={[{ 'is-single': steps.length === 1 }]}>
    {steps.map((step: any) => (
      <li>
        <p>{step.text[lang]}</p>
        {step.command && <Cmd command={step.command} copy={t.copy} copied={t.copied} />}
      </li>
    ))}
  </ol>
  {!compact && (
    <p class="ti__guides">
      {tool.guides.map((g: any) => (
        <a href={g.href[lang]} rel="noopener">{g.label[lang]}</a>
      ))}
    </p>
  )}
</div>

<style>
  .ti { display: grid; gap: 18px; min-width: 0; }
  .ti__downloads { display: flex; flex-wrap: wrap; gap: 10px; }
  .ti__dl {
    display: inline-flex; align-items: center; gap: 12px; padding: 10px 18px 10px 14px; border-radius: var(--r-md);
    background: var(--ink-strong); color: #fff; text-decoration: none; transition: background .15s;
  }
  .ti__dl:hover { background: var(--accent); }
  .ti__dl span { display: grid; gap: 2px; }
  .ti__dl strong { font-weight: 600; font-size: 0.9375rem; }
  .ti__dl small { font-size: 0.75rem; color: #b8c2d8; }
  .ti__dl:hover small { color: #dfe5ff; }
  .ti__note { font-size: 0.875rem; color: var(--muted); max-width: 60ch; }
  .ti__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; counter-reset: step; }
  .ti__steps li { display: grid; gap: 8px; counter-increment: step; position: relative; padding-left: 36px; min-width: 0; }
  .ti__steps li::before {
    content: counter(step); position: absolute; left: 0; top: 0; display: grid; place-items: center;
    width: 24px; height: 24px; border-radius: 50%; border: 1.5px solid var(--line-strong);
    font: 600 0.75rem/1 var(--font); color: var(--ink);
  }
  .ti__steps.is-single li { padding-left: 0; }
  .ti__steps.is-single li::before { display: none; }
  .ti__steps p { color: var(--ink); }
  .ti__guides { display: flex; flex-wrap: wrap; gap: 8px 20px; font-weight: 600; font-size: 0.9375rem; }
  .ti__guides a { color: var(--accent); text-underline-offset: 3px; }
</style>
