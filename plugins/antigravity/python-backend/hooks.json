{
  "description": "Python backend quality gates: Plan-First, Gitflow branch safety, deployment guardrails, and TDD verification.",
  "python-backend-safety-gates": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|call_mcp_tool|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-tool-gate.js",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/stop-gate.js",
        "timeout": 60
      }
    ]
  }
}
