{
  "multi-agent-ops-gates": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "view_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/context-guard-gate.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
