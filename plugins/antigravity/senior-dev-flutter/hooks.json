{
  "description": "Senior Flutter gates: block store builds / major bumps on protected branches, and keep `dart analyze` clean before finishing.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/flutter-pre-tool-gate.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/flutter-stop-gate.js\"",
            "timeout": 130
          }
        ]
      }
    ]
  },
  "senior-dev-flutter-gates": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/flutter-pre-tool-gate.js",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/flutter-stop-gate.js",
        "timeout": 130
      }
    ]
  }
}
