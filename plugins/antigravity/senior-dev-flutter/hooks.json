{
  "senior-dev-flutter-gates": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/flutter-pre-tool-gate.js",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/flutter-stop-gate.js",
        "timeout": 130
      }
    ]
  }
}
