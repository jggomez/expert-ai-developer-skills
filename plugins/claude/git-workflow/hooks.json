{
  "description": "Git hygiene: Gitflow branch safety gate, Conventional Commits validation, and clean merge/rebase verification.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/gitflow-branch-gate.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/git-clean-stop-gate.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
