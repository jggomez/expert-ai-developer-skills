{
  "description": "agent-metrics: hand each finished task (Stop) and session (SessionEnd) to the agent-meter CLI. Always exits 0 and writes nothing to stdout.",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-meter-hook.js\" --host claude-code --event session-end",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-meter-hook.js\" --host claude-code --event task-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
