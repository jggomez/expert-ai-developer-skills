{
  "description": "Senior Flutter gates: block store builds / major bumps on protected branches, enforce PLAN.md before Dart edits, and keep `dart analyze` clean before finishing.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/flutter-pre-tool-gate.js\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/flutter-pre-tool-gate.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/flutter-stop-gate.js\"",
            "timeout": 130
          }
        ]
      }
    ]
  }
}
