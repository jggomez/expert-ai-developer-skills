      "url": "https://bigquery.googleapis.com/mcp"
    },
    "datastream": {
      "type": "http",
      "url": "https://datastream.googleapis.com/mcp"
    },
    "dataform": {
      "type": "http",
      "url": "https://dataform.${GCP_REGION:-us-central1}.rep.googleapis.com/mcp",
