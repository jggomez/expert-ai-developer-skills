{
  "description": "Git hygiene: Gitflow branch safety gate, commit message standards, and PR conventions.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/gitflow-branch-gate.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
